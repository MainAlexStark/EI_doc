# Скопировать в .env и заполнить. .env в git не хранится — никогда.
# Сгенерировать ключ:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

SECRET_KEY=замените-меня
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

DB_NAME=ei_doc
DB_USER=ei_doc
DB_PASSWORD=замените-меня
DB_HOST=postgres
DB_PORT=5432

REDIS_URL=redis://redis:6379/0

# ФГИС «Аршин». Ключи взяты из старого config.yaml — проверить, что именно они открывают.
ARSHIN_BASE_URL=https://fgis.gost.ru/fundmetrology/eapi
ARSHIN_PUBLIC_KEY=
ARSHIN_PRIVATE_KEY=
# Скачивать методику поверки и описание типа в фоне, когда тип заводится из ФИФ.
FIF_DOCUMENTS_AUTO_DOWNLOAD=True
# Госреестр: auto — через MCP-сервер РСТ (RST_MCP_URL), при отказе — напрямую; mcp | direct — только этот путь
FIF_TRANSPORT=auto
# Прошлые поверки по заводскому номеру: за сколько прошлых лет искать в «Аршине» (запрос на каждый год)
FIF_VRI_YEARS_BACK=7
MEDIA_ROOT=/srv/media
LOG_LEVEL=INFO

# Капча на форме заявки (этап 2) — Yandex SmartCaptcha, https://cloud.yandex.ru/docs/smartcaptcha/
# Пусто — форма работает на одном honeypot-поле, без виджета.
CAPTCHA_CLIENT_KEY=
CAPTCHA_SERVER_KEY=

# Подсказка адресов на форме заявки (этап 2). Ключ — на dadata.ru, бесплатный тариф хватает.
DADATA_API_KEY=
# Координаты адресов командировок для карты: auto — DaData (если есть ключ), иначе
# Nominatim (OpenStreetMap, без ключа); off — не искать, точки только с телефона.
GEOCODER=auto
# Тайлы карты: сервер сам скачивает их и хранит в MEDIA_ROOT/tiles. Контакт уходит
# в User-Agent — так просит политика OSM. Источник можно заменить на другой растровый.
MAP_TILES_UPSTREAM=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILES_CONTACT=
# Маршрут дня с пробками: ключ 2ГИС (platform.2gis.ru → демо-ключ или подписка).
# Пусто — порядок и время считаются по прямой, без пробок.
DGIS_API_KEY=
# Откуда выезжаем по умолчанию (офис). Если знаете координаты — точнее.
ROUTE_BASE_ADDRESS=Киров, улица Горького, 4
# ROUTE_BASE_LAT=58.60
# ROUTE_BASE_LON=49.67

# Telegram-бот для уведомлений (этап 2). Пусто — уведомления только логируются.
TELEGRAM_BOT_TOKEN=
# Секрет в пути вебхука бота — сгенерировать так же, как SECRET_KEY. Без него
# вебхук выключен (сотрудники привязываются кодом из своего профиля в EI_doc).
TELEGRAM_WEBHOOK_SECRET=
# Необязательно: имя бота без @, только для подсказки в профиле сотрудника.
TELEGRAM_BOT_USERNAME=

# Распознавание бумажных бланков — Yandex AI Studio (этап 3, второй срез,
# см. claude/scans.md). Оба ключа нужны вместе (API-ключ сервисного аккаунта
# + ID каталога, https://yandex.cloud/docs/ai-studio/). Пусто — распознавание
# выключено: поверитель заводит поверку с того же бланка вручную, глядя на
# фото на экране сверки, как обычно при вводе без связи.
YANDEX_VISION_API_KEY=
YANDEX_VISION_FOLDER_ID=
# Необязательно: код модели в AI Studio. Пусто — берётся значение по
# умолчанию из кода (qwen3.6-35b-a3b) — менять здесь только если Яндекс
# сменил доступную мультимодальную модель.
YANDEX_VISION_MODEL=

# Ассистент-метролог (вкладка «Ассистент», claude/assistant.md).
# OpenRouter — каталог моделей (Claude, GPT, Gemini…): https://openrouter.ai/keys
# Пусто — в выборе остаются только модели Yandex AI Studio (ключи YANDEX_VISION_* выше).
OPENROUTER_API_KEY=
# Прокси только для OpenRouter (с российских адресов он отвечает 403):
# http://user:pass@host:port или socks5h://user:pass@host:port. Пусто — напрямую.
OPENROUTER_PROXY=
# Модель по умолчанию «провайдер:модель», например openrouter:anthropic/claude-sonnet-4.5
# (правится и в интерфейсе: «Контекст → Настройки»).
ASSISTANT_DEFAULT_MODEL=
# Модели Yandex AI Studio в выборе, через запятую.
ASSISTANT_YANDEX_MODELS=qwen3-235b-a22b-fp8/latest,yandexgpt/latest
# Адрес сайта для статистики OpenRouter (HTTP-Referer), например https://doc.example.ru
ASSISTANT_PUBLIC_URL=
# RSTMetrology_MCP — реестр ФГИС «Аршин» для агента. Внутри mcp-network по имени
# контейнера: http://<контейнер>:<порт>/mcp. Заводится сам при migrate.
RST_MCP_URL=
RST_MCP_TOKEN=
# Веб-поиск — Yandex Search API v2. Пусто — берётся YANDEX_VISION_API_KEY (тому же
# сервисному аккаунту нужна роль search-api.webSearch.user).
YANDEX_SEARCH_API_KEY=

# Ассистент на agentkit (agent/). Пусто AGENT_URL — вкладка «Ассистент» работает по-старому.
# agent/deploy.sh заполняет всё это сам; руками — только локально.
AGENT_URL=
AGENT_LOGIN_SECRET=
AGENT_HOST_TOKEN=
AGENT_INTERNAL_URL=http://ei-agent:8080
AGENT_SERVICE_TOKEN=

# Нагрузка (см. backend/config/gunicorn.py). Пусто — по умолчанию.
# GUNICORN_WORKERS=5
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=120
# CELERY_CONCURRENCY=4
# DB_CONN_MAX_AGE=60
# Сколько доверенных прокси перед gunicorn (Caddy) — для лимитов по IP. В prod по умолчанию 1.
# NUM_PROXIES=1
# THROTTLE_PUBLIC_REQUEST=20/hour

# --- Почта и уведомления (apps.notify, как в openseller) ---
# Пусто SMTP_HOST — письма только пишутся в журнал сервера, «Забыли пароль?» отвечает,
# что почта не настроена. Порт 465 — сразу TLS (Яндекс 360, Mail.ru), 587 — STARTTLS.
# SMTP_TLS: implicit | starttls; пусто — по порту. Открытым текстом пароль не отправляется.
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS=
SMTP_USERNAME=
SMTP_PASSWORD=
# Отправитель. Пусто — SMTP_USERNAME.
MAIL_FROM=EI_doc <noreply@eicounters.ru>
# Адрес кабинета для ссылок в письмах. Пусто — первый из CSRF_TRUSTED_ORIGINS.
APP_PUBLIC_URL=https://ei-doc.eicounters.ru
# Через сколько секунд после события собирать сводку (назначили пачкой — одно письмо).
# NOTIFY_FLUSH_DELAY=20
# THROTTLE_PASSWORD_CHANGE=10/hour
# THROTTLE_PASSWORD_FORGOT=5/hour
# THROTTLE_PASSWORD_RESET=30/hour      # проверка ссылки и сам сброс — своя корзина
# PASSWORD_FORGOT_PER_ADDRESS=3        # писем сброса на один адрес в час

# --- Почта фирмы в кабинете (apps.mailbox, вкладка «Почта») ---
# Ящики Timeweb: письма читаются по IMAP, ответы уходят SMTP того же ящика,
# копия кладётся в «Отправленные». DNS/MX не меняем — ящики работают и в
# веб-почте Timeweb, и в почтовых программах как раньше. Видят панель
# владелец, руководитель и менеджеры. Пусто — вкладка выключена.
# Имя (латиница) = адрес, через запятую; пароль — MAILBOX_PASSWORD_<ИМЯ>.
MAILBOXES=
# MAILBOXES=info=info@eicounters.ru,zakupki=zakupki@eicounters.ru
# MAILBOX_PASSWORD_INFO=
# MAILBOX_PASSWORD_ZAKUPKI=
# По умолчанию — серверы Timeweb (можно задать и для одного ящика: MAILBOX_IMAP_HOST_INFO=…)
MAILBOX_IMAP_HOST=imap.timeweb.ru
MAILBOX_IMAP_PORT=993
MAILBOX_SMTP_HOST=smtp.timeweb.ru
MAILBOX_SMTP_PORT=465
# MAILBOX_SMTP_TLS=       # пусто — по порту (465 → SSL, 587 → STARTTLS)
# MAILBOX_FROM_NAME=ООО «Единица Измерения»
# MAILBOX_MAX_MB=25       # письма больше — только заголовки, целиком — в веб-почте Timeweb
# MAILBOX_INITIAL_LIMIT=500  # сколько последних писем на папку забрать при первой синхронизации
