# Скопировать в .env и заполнить. .env в git не хранится — никогда.
# Сгенерировать ключ:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

SECRET_KEY=замените-меня
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

DB_NAME=ei_doc
DB_USER=ei_doc
DB_PASSWORD=замените-меня
DB_HOST=postgres
DB_PORT=5432

REDIS_URL=redis://redis:6379/0

# ФГИС «Аршин». Ключи взяты из старого config.yaml — проверить, что именно они открывают.
ARSHIN_BASE_URL=https://fgis.gost.ru/fundmetrology/eapi
ARSHIN_PUBLIC_KEY=
ARSHIN_PRIVATE_KEY=
# Скачивать методику поверки и описание типа в фоне, когда тип заводится из ФИФ.
FIF_DOCUMENTS_AUTO_DOWNLOAD=True
MEDIA_ROOT=/srv/media
LOG_LEVEL=INFO

# Капча на форме заявки (этап 2) — Yandex SmartCaptcha, https://cloud.yandex.ru/docs/smartcaptcha/
# Пусто — форма работает на одном honeypot-поле, без виджета.
CAPTCHA_CLIENT_KEY=
CAPTCHA_SERVER_KEY=

# Подсказка адресов на форме заявки (этап 2). Ключ — на dadata.ru, бесплатный тариф хватает.
DADATA_API_KEY=

# Telegram-бот для уведомлений (этап 2). Пусто — уведомления только логируются.
TELEGRAM_BOT_TOKEN=
# Секрет в пути вебхука бота — сгенерировать так же, как SECRET_KEY. Без него
# вебхук выключен (сотрудники привязываются кодом из своего профиля в EI_doc).
TELEGRAM_WEBHOOK_SECRET=
# Необязательно: имя бота без @, только для подсказки в профиле сотрудника.
TELEGRAM_BOT_USERNAME=

# Распознавание бумажных бланков — Yandex AI Studio (этап 3, второй срез,
# см. claude/scans.md). Оба ключа нужны вместе (API-ключ сервисного аккаунта
# + ID каталога, https://yandex.cloud/docs/ai-studio/). Пусто — распознавание
# выключено: поверитель заводит поверку с того же бланка вручную, глядя на
# фото на экране сверки, как обычно при вводе без связи.
YANDEX_VISION_API_KEY=
YANDEX_VISION_FOLDER_ID=
# Необязательно: код модели в AI Studio. Пусто — берётся значение по
# умолчанию из кода (qwen3.6-35b-a3b) — менять здесь только если Яндекс
# сменил доступную мультимодальную модель.
YANDEX_VISION_MODEL=

# Ассистент-метролог (вкладка «Ассистент», claude/assistant.md).
# OpenRouter — каталог моделей (Claude, GPT, Gemini…): https://openrouter.ai/keys
# Пусто — в выборе остаются только модели Yandex AI Studio (ключи YANDEX_VISION_* выше).
OPENROUTER_API_KEY=
# Прокси только для OpenRouter (с российских адресов он отвечает 403):
# http://user:pass@host:port или socks5h://user:pass@host:port. Пусто — напрямую.
OPENROUTER_PROXY=
# Модель по умолчанию «провайдер:модель», например openrouter:anthropic/claude-sonnet-4.5
# (правится и в интерфейсе: «Контекст → Настройки»).
ASSISTANT_DEFAULT_MODEL=
# Модели Yandex AI Studio в выборе, через запятую.
ASSISTANT_YANDEX_MODELS=qwen3-235b-a22b-fp8/latest,yandexgpt/latest
# Адрес сайта для статистики OpenRouter (HTTP-Referer), например https://doc.example.ru
ASSISTANT_PUBLIC_URL=
# RSTMetrology_MCP — реестр ФГИС «Аршин» для агента. Внутри mcp-network по имени
# контейнера: http://<контейнер>:<порт>/mcp. Заводится сам при migrate.
RST_MCP_URL=
RST_MCP_TOKEN=
# Веб-поиск — Yandex Search API v2. Пусто — берётся YANDEX_VISION_API_KEY (тому же
# сервисному аккаунту нужна роль search-api.webSearch.user).
YANDEX_SEARCH_API_KEY=
